# Copie para .env e preencha. O .env é lido automaticamente pelo docker compose.

# Fuso horário dos timestamps nos relatórios e nomes de arquivo
TZ=America/Campo_Grande

# Porta da interface web (o Easypanel espera 3000)
PORT=3000

# ── Autenticação — SEM ISTO O SERVIÇO NÃO ABRE (falha fechada) ──
#
# Aqui vão apenas HASHES, nunca os segredos. Variável de ambiente não é cofre:
# o valor aparece na UI do Easypanel, em `docker inspect` e em dump de erro.
#
# Gere cada credencial com:
#   python gerar_credencial.py api siap      → token + hash da API
#   python gerar_credencial.py painel        → senha + hash do painel
#
# O segredo aparece uma única vez na tela do gerador e não fica gravado.

# Hash dos tokens da API: "rotulo:sha256:<hash>", separado por vírgula.
# Para rotacionar sem parar a integração, deixe dois hashes no mesmo rótulo.
API_TOKENS=siap:sha256:cole-o-hash-gerado-aqui

# Hash scrypt da senha do painel
SENHA_PAINEL_HASH=scrypt$16384$8$1$cole-o-hash-gerado-aqui

# Marque a sessão como Secure (só trafega em HTTPS). Ative em produção.
COOKIE_SEGURO=1

# Horas até a sessão do painel expirar
HORAS_SESSAO=12

# ── Limites de execução ──────────────────────────────────────────
#
# Tamanho máximo de um lote, em MB. O upload é gravado em disco em blocos de
# 1 MB, então o tamanho não pesa na memória — mas O PROXY À FRENTE DO SERVIÇO
# (Easypanel/Traefik/nginx) TEM LIMITE PRÓPRIO DE CORPO DE REQUISIÇÃO, e é ele
# quem costuma recusar primeiro, com 413, antes de a requisição chegar aqui.
# Se um envio grande falhar, aumente o limite lá também.
MAX_MB_LOTE=500

# Teto de tempo de cada etapa (Agente 1, depois Agente 2), em segundos.
# A fila é serial: sem teto, um agente travado segura todos os lotes seguintes.
TIMEOUT_AGENTE_S=3600

# ── OCR — só entra em ação nas páginas digitalizadas ─────────────
#
# São estes três que governam o PICO DE MEMÓRIA. Se o container for morto por
# falta de memória (o log mostra "encerrou com código -9"), reduza primeiro
# OCR_MAX_LOTE e OCR_MAX_WORKERS — o DPI afeta a qualidade do reconhecimento.
#
# Custo por página: 300dpi≈1,27s · 200dpi≈0,73s · 150dpi≈0,52s.
OCR_DPI=200
OCR_MAX_LOTE=10
OCR_MAX_WORKERS=2

# Teto de memória do container. Mínimo recomendado: 2g.
MEM_LIMITE=2g

# ── Retenção em disco ────────────────────────────────────────────
#
# Os PDFs recebidos são o que pesa: o do cliente tem 100 MB cada, e nada os
# apagava — o volume enchia em silêncio até o serviço parar de aceitar envio.
# O original continua com quem enviou; o que o serviço produziu (planilha,
# JSON) sobrevive até a retenção do lote.
#
# 0 desliga a limpeza e mantém tudo.
RETENCAO_PDF_DIAS=7
RETENCAO_LOTE_DIAS=90

# ── Priorização do Agente 2 (em R$) ──────────────────────────────
#
# Ordenam o trabalho do procurador; NÃO são critério de ajuizamento e não
# derivam de norma. Valores provisórios definidos pela HERA — substituir pelo
# valor mínimo de ajuizamento oficial da PGMS quando definido.
#
#   ALTA  → dívida >= ALTA, OU risco de prescrição, OU 5 anos sem movimentação
#   MEDIA → entre MEDIA e ALTA
#   BAIXA → abaixo de MEDIA
LIMIAR_PRIORIDADE_ALTA=5000
LIMIAR_PRIORIDADE_MEDIA=1000
